# Model access through Vercel AI Gateway: https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Comma-separated public repos depwatch may scan, e.g. owner/repo,owner/other-repo
DEPWATCH_REPOS=

# Slack: bot token and signing secret from https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Channel the weekly digest is posted to, e.g. C0123ABC
DEPWATCH_SLACK_CHANNEL_ID=
